<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="viajes.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="3454"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="ItinerarioGeneral" custom_title="0" dock_id="1" table="4,17:mainItinerarioGeneral"/><dock_state state="000000ff00000000fd00000001000000020000058100000390fc0100000001fb000000160064006f0063006b00420072006f00770073006500310100000000000005810000011e00ffffff000002690000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings><table schema="main" name="ActividadesDisponibles" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="35"/><column index="2" value="97"/><column index="3" value="300"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="ItinerarioGeneral" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="35"/><column index="2" value="97"/><column index="3" value="87"/><column index="4" value="87"/><column index="5" value="81"/><column index="6" value="300"/><column index="7" value="300"/><column index="8" value="65"/><column index="9" value="50"/><column index="10" value="300"/><column index="11" value="87"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="actividades" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="35"/><column index="2" value="97"/><column index="3" value="74"/><column index="4" value="97"/><column index="5" value="132"/><column index="6" value="300"/><column index="7" value="300"/><column index="8" value="65"/><column index="9" value="50"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">SELECT 
  a.id AS actividadId,
  a.nombre AS actividadNombre,
  a.descripcion AS actividadDescripcion,
  a.horaInicio,
  a.horaFin,
  i.id AS itinerarioId,
  i.fechaInicio,
  i.fechaFin,
  i.destinosPorDia,
  v.id AS viajeId,
  v.nombre AS nombreViaje,
  v.destino
FROM actividades a
JOIN ItinerarioGeneral i ON a.itinerarioId = i.id
JOIN viajes v ON a.viajePrevistoId = v.id
WHERE 
  DATE('2025-08-15') BETWEEN DATE(i.fechaInicio) AND DATE(i.fechaFin)
  AND TIME(a.horaInicio) &lt;= TIME('18:33')
  AND TIME(a.horaFin) &gt;= TIME('18:33')
ORDER BY a.horaInicio ASC;
</sql><current_tab id="0"/></tab_sql></sqlb_project>
